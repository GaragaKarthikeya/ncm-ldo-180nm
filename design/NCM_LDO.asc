TEXT -160 672 Left 2 !.include ../models/models_292p.txt
TEXT -160 704 Left 2 !.nodeset V(out)=1.401 V(g)=1.048 V(r)=1.397 V(gc)=0.828 V(od)=0.612 V(tp)=1.069 V(a2)=0.636 V(d1)=0.790
